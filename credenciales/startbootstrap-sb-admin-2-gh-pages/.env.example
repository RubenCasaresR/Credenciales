# Credenciales - Environment Configuration
# Copy this file to .env and replace the values with your own secure keys.

# Encryption key for generic credentials (AES-256-CBC)
ENCRYPTION_KEY=cambia_esto_por_una_clave_segura

# Encryption key for payment gateway secrets (libsodium secretbox)
# Generate a 32-byte (64 hex chars) key: php -r "echo bin2hex(sodium_randombytes_buf(SODIUM_CRYPTO_SECRETBOX_KEYBYTES));"
PAYMENT_ENCRYPTION_KEY=cambia_esto_por_una_clave_segura_de_32_bytes_en_hex
